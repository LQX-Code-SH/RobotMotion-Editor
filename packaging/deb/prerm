#!/bin/sh
# robot-editor 卸载/升级前：停桥接、摘站点链接，避免残留进程占用端口。
set -e

case "$1" in
    remove|deconfigure)
        systemctl stop robot-editor >/dev/null 2>&1 || true
        systemctl disable robot-editor >/dev/null 2>&1 || true
        rm -f /etc/nginx/sites-enabled/robot-editor.conf
        if systemctl is-active nginx >/dev/null 2>&1; then
            systemctl reload nginx >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0

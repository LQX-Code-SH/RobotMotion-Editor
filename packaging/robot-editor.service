[Unit]
Description=Robot Motion Editor (bridge + web frontend)
Documentation=file:/usr/share/doc/robot-editor/USAGE.md
# 本项目作为一个整体管理：start 同时拉起前端 nginx，stop 同时停掉前端。
# ROS 2 的 DDS 依赖网络就绪；不要求图形会话
After=network-online.target nginx.service
Wants=network-online.target nginx.service
# systemd >= 249：停止本单元时同步停止 nginx（restart 不影响 nginx）
PropagatesStopTo=nginx.service

[Service]
Type=simple
# 必须是能访问 ROS 2 话题的那个普通用户（安装时按构建用户写入），不要用 root
User=@RUN_USER@
Environment=HOME=/home/@RUN_USER@
ExecStart=/usr/bin/robot-editor _exec
# 桥接异常退出时自动拉起；正常停止（SIGTERM 看门狗）不重启
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10
# 日志进 journald：robot-editor logs -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
